# Environment variables — copy to .env and fill in values
# DO NOT commit .env to git

# Supabase
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Groq (for ultra-fast Chatbot AI instead of Gemini)
GROQ_API_KEY=your_groq_api_key_here...

# Google Cloud (used for ownerbot TTS & Translation)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_TTS_API_KEY=AIza...  # Can be same as GOOGLE_API_KEY

# Replicate (for Whisper STT)
REPLICATE_API_TOKEN=r8_...

# Firebase (only needed for one-time data migration script)
GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}
